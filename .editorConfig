# Baseline whitespace rules, applied by the editor rather than by a formatter.
# Prettier arrives in Step 1F; this keeps files consistent before then and
# keeps non-JS files (CSS, JSON, Markdown, YAML) consistent afterwards.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2