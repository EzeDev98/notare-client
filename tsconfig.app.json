{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleDetection": "force",
    "useDefineForClassFields": true,
    "jsx": "react-jsx",

    /* Vite bundles; tsc only checks. */
    "types": ["vite/client"],

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,

    /* Tells the TYPE CHECKER what "@/lib/http" means.
       Vite is told separately in vite.config.ts. */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* strict is eight flags. The four below are NOT in it. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,

    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedSideEffectImports": true,

    /* Bans TS enums, namespaces, parameter properties: syntax that emits
       runtime code. The backend's finite states become unions, not enums. */
    "erasableSyntaxOnly": true
  },
  "include": ["src", "tests"]
}
