# Copy to .env.local and adjust. .env.local is git-ignored.
#
# WARNING: every VITE_-prefixed variable is inlined into the production
# bundle and readable by anyone via view-source. Never put a secret here.
# Variables WITHOUT the prefix are visible only to vite.config.ts, which
# runs in Node.

# --- Client -----------------------------------------------------------------
# Where the API lives, from the browser's point of view.
# In development this is a same-origin path handled by the dev proxy below.
# In production, set an absolute URL: https://api.example.com/api/v1
VITE_API_BASE_URL=/api/v1

# The server's timezone, as an IANA name.

#

# Needed because most API timestamps are Java LocalDateTime — no zone, no

# offset ("2026-08-08T10:00:00.000"). JavaScript parses those as LOCAL time,

# which is silently wrong by the offset for any user outside the server's zone.

# This is what lets the client convert them to real instants.

#

# An IANA name rather than a fixed offset so DST is resolved correctly. Lagos

# has none; the app should not assume its server always will.

VITE_SERVER_TIME_ZONE=Africa/Lagos

# The server's timezone, as an IANA name.
#
# Needed because most API timestamps are Java LocalDateTime — no zone, no
# offset ("2026-08-08T10:00:00.000"). JavaScript parses those as LOCAL time,
# which is silently wrong by the offset for any user outside the server's zone.
# This is what lets the client convert them to real instants.
#
# An IANA name rather than a fixed offset so DST is resolved correctly. Lagos
# has none; the app should not assume its server always will.
VITE_SERVER_TIME_ZONE=Africa/Lagos

# --- Dev server only (not shipped) ------------------------------------------
# Where the proxy forwards /api/* during `npm run dev`.
NOTARE_DEV_PROXY_TARGET=http://localhost:2001
